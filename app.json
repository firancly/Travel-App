{
  "expo": {
    "name": "Navigate the Moment",
    "slug": "travel-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "navigatethemoment",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.navigatethemoment.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Navigate the Moment uses your location to show nearby recommendations on the map."
      }
    },
    "android": {
      "package": "com.navigatethemoment.app",
      "adaptiveIcon": {
        "backgroundColor": "#E8F5EC",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "@react-native-community/datetimepicker",
      "expo-font",
      [
        "react-native-maps",
        {
          "androidGoogleMapsApiKey": "AIzaSyBaGxXqfnnJ2JsxKZMyECvO4k4U-z3DHbI"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/splash-icon.png",
          "imageWidth": 180
        }
      ],
      "expo-router",
      "expo-status-bar"
    ]
  }
}
